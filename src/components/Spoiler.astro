---
import { CloudIcon, EyeIcon } from '@phosphor-icons/react/dist/ssr';
import type { Marker, Saga } from '../lib/schema';
import { describeMarker } from '../lib/spoilers';

interface Props {
  saga: Saga;
  at: Marker;
  /** Qué se oculta, para el velo: "Un dato", "Una relación"… */
  label?: string;
  as?: 'div' | 'li';
}

const { saga, at, label = 'Un spoiler', as: Tag = 'div' } = Astro.props;
const when = describeMarker(saga, at);
---

<Tag
  class="spoiler"
  data-spoiler
  data-saga={saga.id}
  data-game={at.game}
  data-chapter={at.chapter}
  data-revealed="false"
  data-pagefind-ignore="all"
>
  <div class="spoiler__veil fog-card">
    <CloudIcon className="icon" aria-hidden="true" weight="duotone" />
    <span><strong>{label}</strong> en la niebla. Se despeja al terminar {when}.</span>
    <button type="button" class="btn btn--sm" data-spoiler-reveal>
      <EyeIcon className="icon" aria-hidden="true" weight="bold" />
      Ver spoiler
    </button>
  </div>
  <template><slot /></template>
  <div data-spoiler-body tabindex="-1" hidden></div>
</Tag>
