---
import type { Marker, Saga } from '../lib/schema';
import { describeMarker } from '../lib/spoilers';
import LockIcon from './LockIcon.astro';

interface Props {
  saga: Saga;
  at: Marker;
  /** Qué se oculta, para el velo: "Dato oculto", "Personaje oculto"… */
  label?: string;
  as?: 'div' | 'li';
}

const { saga, at, label = 'Spoiler', as: Tag = 'div' } = Astro.props;
const when = describeMarker(saga, at);
---

<Tag
  class="spoiler"
  data-spoiler
  data-saga={saga.id}
  data-game={at.game}
  data-chapter={at.chapter}
  data-revealed="false"
  data-pagefind-ignore="all"
>
  <div class="spoiler__veil">
    <LockIcon />
    <span><strong>{label}</strong> · se desbloquea al terminar {when}</span>
    <button type="button" class="btn btn--sm btn--ghost" data-spoiler-reveal>Mostrar igual</button>
  </div>
  <template><slot /></template>
  <div data-spoiler-body tabindex="-1" hidden></div>
</Tag>
