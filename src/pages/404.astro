---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Página no encontrada" description="Esta página no existe en Crónicas." indexable={false}>
  <section class="wrap lost">
    <p class="eyebrow">Error 404</p>
    <h1>Esta parte de la historia no existe</h1>
    <p class="muted">Puede que el enlace esté roto o que la página se haya movido.</p>
    <a class="btn btn--primary" href={url()}>Volver a las sagas</a>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 10vw, 7rem);
    max-width: 640px;
  }
</style>
