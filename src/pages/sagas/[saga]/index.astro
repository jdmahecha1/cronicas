---
import ProgressPanel from '../../../components/ProgressPanel';
import RelationGraph from '../../../components/RelationGraph';
import Spoiler from '../../../components/Spoiler.astro';
import Timeline from '../../../components/Timeline';
import Base from '../../../layouts/Base.astro';
import { getSagas } from '../../../lib/data';
import type { Saga } from '../../../lib/schema';
import { gamesByRelease } from '../../../lib/spoilers';
import { characterUrl, url } from '../../../lib/url';

export function getStaticPaths() {
  return getSagas().map((saga) => ({ params: { saga: saga.id }, props: { saga } }));
}

interface Props {
  saga: Saga;
}

const { saga } = Astro.props;
const games = gamesByRelease(saga);
// Primero los personajes conocidos desde el principio, luego los que aparecen más tarde.
const characters = [...saga.characters].sort((a, b) => Number(!!a.appears) - Number(!!b.appears));
---

<Base title={saga.title} description={`${saga.tagline} ${saga.synopsis}`} accent={saga.accent}>
  <section class="saga-hero">
    <div class="wrap">
      <nav aria-label="Ruta" class="crumbs"><a href={url()}>Sagas</a> / <span>{saga.title}</span></nav>
      <p class="eyebrow">{saga.studio} · {saga.genre}</p>
      <h1>{saga.title}</h1>
      <p class="saga-hero__tagline">{saga.tagline}</p>
      <p class="saga-hero__synopsis">{saga.synopsis}</p>
      <nav class="saga-hero__jump" aria-label="Secciones">
        <a class="chip" href="#juegos">Juegos</a>
        <a class="chip" href="#cronologia">Línea de tiempo</a>
        <a class="chip" href="#personajes">Personajes</a>
        <a class="chip" href="#relaciones">Relaciones</a>
      </nav>
    </div>
  </section>

  <div class="wrap saga-layout">
    <aside class="saga-layout__aside" data-pagefind-ignore="all">
      <ProgressPanel client:load saga={saga} />
    </aside>

    <div class="saga-layout__main">
      <section id="juegos" class="block" aria-labelledby="juegos-titulo">
        <h2 id="juegos-titulo">Juegos</h2>
        <ol class="games">
          {
            games.map((game) => (
              <li class="card games__item">
                <span class="games__year">{game.year}</span>
                <h3>{game.title}</h3>
                <p class="muted games__chapters">
                  {game.chapters.length} {game.chapters.length === 1 ? 'etapa' : 'etapas'}
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="cronologia" class="block" aria-labelledby="cronologia-titulo" data-pagefind-ignore="all">
        <h2 id="cronologia-titulo">Línea de tiempo</h2>
        <Timeline client:load saga={saga} />
      </section>

      <section id="personajes" class="block" aria-labelledby="personajes-titulo">
        <h2 id="personajes-titulo">Personajes</h2>
        <ul class="people">
          {
            characters.map((c) => {
              const card = (
                <a class="person card" href={characterUrl(saga.id, c.id)}>
                  <span class="person__name">{c.name}</span>
                  <span class="person__role">{c.role}</span>
                  <span class="person__intro">{c.intro}</span>
                </a>
              );
              return c.appears ? (
                <Spoiler as="li" saga={saga} at={c.appears} label="Personaje oculto">
                  {card}
                </Spoiler>
              ) : (
                <li>{card}</li>
              );
            })
          }
        </ul>
      </section>

      <section id="relaciones" class="block" aria-labelledby="relaciones-titulo" data-pagefind-ignore="all">
        <h2 id="relaciones-titulo">Mapa de relaciones</h2>
        <RelationGraph client:idle saga={saga} />
      </section>
    </div>
  </div>
</Base>

<style>
  .saga-hero {
    padding-block: clamp(2rem, 6vw, 4rem) 1.5rem;
  }

  .crumbs {
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
    color: var(--faint);
  }

  .crumbs a {
    color: var(--muted);
  }

  .saga-hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-style: italic;
    color: var(--accent-text);
  }

  .saga-hero__synopsis {
    max-width: 68ch;
    color: var(--muted);
  }

  .saga-hero__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .saga-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .saga-layout {
      grid-template-columns: 330px minmax(0, 1fr);
    }

    .saga-layout__aside {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 100px);
      overflow: hidden auto;
      scrollbar-width: thin;
    }
  }

  .block {
    margin-bottom: 3.5rem;
    scroll-margin-top: 84px;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .games__item {
    padding: 1rem 1.1rem;
  }

  .games__item h3 {
    font-size: 1.02rem;
    margin: 0.2rem 0 0.25rem;
  }

  .games__year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .games__chapters {
    margin: 0;
    font-size: 0.84rem;
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .person {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .person:hover {
    border-color: var(--accent);
  }

  .person__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .person__role {
    font-size: 0.8rem;
    color: var(--accent-text);
  }

  .person__intro {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
