---
import Base from '../layouts/Base.astro';
import { OWNERS, coverFor, landscapeFor, portraitFor } from '../lib/artwork';
import { getSagas } from '../lib/data';

const sagas = getSagas();
const credits = sagas.map((saga) => ({
  saga,
  owner: OWNERS[saga.id] ?? saga.studio,
  games: saga.games.flatMap((game) => {
    const cover = coverFor(game.id);
    return cover ? [{ game, cover }] : [];
  }),
  landscape: landscapeFor(saga.id),
  // Nombrar a un personaje que aparece más adelante ya es un spoiler: esos van aparte, plegados.
  portraits: saga.characters.flatMap((c) => {
    const art = portraitFor(saga.id, c.id);
    return art ? [{ character: c, art }] : [];
  }),
}));
const total = credits.reduce((n, c) => n + c.games.length, 0);
const totalPortraits = credits.reduce((n, c) => n + c.portraits.length, 0);
---

<Base
  title="Créditos"
  description="Créditos de las imágenes, tipografías e iconos de Crónicas, y cómo pedir que se retire una imagen."
>
  <article class="wrap credits">
    <h1>Créditos</h1>
    <p class="credits__lead">
      Crónicas es un proyecto de fans, gratuito y sin publicidad. No vende nada ni tiene relación con
      los estudios o editoras de los juegos.
    </p>

    <section>
      <h2>Imágenes de los juegos</h2>
      <p>
        Las {total} portadas son arte promocional oficial de cada juego, en la versión de resolución
        reducida que publica Wikipedia. Se usan con fines informativos y sin ánimo de lucro, y sus
        derechos pertenecen a sus dueños. Cada enlace lleva a la página del archivo, con su fuente y
        descripción.
      </p>
      {
        credits.map(({ saga, owner, games }) => (
          <div class="credits__saga">
            <h3>
              {saga.title} <span>© {owner}</span>
            </h3>
            <ul class="credits__list">
              {games.map(({ game, cover }) => (
                <li>
                  <strong>{game.title}</strong>
                  <span>
                    Portada. <a href={cover.page} rel="nofollow">Archivo en Wikipedia</a>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Retratos y paisajes</h2>
      <p>
        Los {totalPortraits} retratos de personajes y los paisajes de fondo son arte oficial y capturas de
        los juegos, tomados de las wikis de cada saga en Fandom, donde la comunidad documenta su origen.
        Se muestran recortados y a resolución reducida, y sus derechos pertenecen a sus dueños. Cada
        enlace lleva a la página del archivo en su wiki.
      </p>
      {
        credits.map(({ saga, owner, landscape, portraits }) => {
          const known = portraits.filter(({ character }) => !character.appears);
          const later = portraits.filter(({ character }) => character.appears);
          return (
            <div class="credits__saga">
              <h3>
                {saga.title} <span>© {owner}</span>
              </h3>
              <ul class="credits__list">
                {landscape && (
                  <li>
                    <strong>Paisaje de fondo</strong>
                    <span>
                      <a href={landscape.page} rel="nofollow">{landscape.file}</a>
                    </span>
                  </li>
                )}
                {known.map(({ character, art }) => (
                  <li>
                    <strong>{character.name}</strong>
                    <span>
                      Retrato. <a href={art.page} rel="nofollow">Archivo en {art.wiki}</a>
                    </span>
                  </li>
                ))}
              </ul>
              {later.length > 0 && (
                <details class="credits__later" data-pagefind-ignore="all">
                  <summary>
                    {later.length} {later.length === 1 ? 'personaje' : 'personajes'} que aparecen más adelante
                    (sus nombres son spoilers)
                  </summary>
                  <ul class="credits__list">
                    {later.map(({ character, art }) => (
                      <li>
                        <strong>{character.name}</strong>
                        <span>
                          Retrato. <a href={art.page} rel="nofollow">Archivo en {art.wiki}</a>
                        </span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          );
        })
      }
      <p>
        Si una imagen no carga, en su lugar se ve un paisaje propio, generado con código.
      </p>
    </section>

    <section id="retiro">
      <h2>¿Eres titular de alguna imagen?</h2>
      <p>
        Si quieres que retire una imagen o cambie su crédito, abre un issue en
        <a href="https://github.com/jdmahecha1/cronicas/issues">GitHub</a> indicando cuál es. La retiraré
        lo antes posible, sin necesidad de más trámites.
      </p>
    </section>

    <section>
      <h2>Textos, tipografías e iconos</h2>
      <ul class="credits__list">
        <li>
          <strong>Resúmenes de las historias</strong>
          <span>Redacción propia, bajo licencia CC BY-SA 4.0.</span>
        </li>
        <li>
          <strong>Bricolage Grotesque e Inter Tight</strong>
          <span>Tipografías bajo SIL Open Font License, autoalojadas con Fontsource.</span>
        </li>
        <li>
          <strong>Phosphor Icons</strong>
          <span>Iconos bajo licencia MIT.</span>
        </li>
      </ul>
      <p>
        Los nombres de los juegos y personajes son marcas de sus respectivos dueños: Nintendo, Rockstar
        Games, CD Projekt, Electronic Arts y BioWare, Konami y Sony Interactive Entertainment.
      </p>
    </section>
  </article>
</Base>

<style>
  .credits {
    max-width: 780px;
    padding-top: var(--space-7);
  }

  .credits__lead {
    color: var(--muted);
    font-size: var(--step-2);
    line-height: 1.5;
  }

  .credits section {
    margin-top: var(--space-6);
  }

  .credits__list {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .credits__list li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-field);
    background: var(--surface);
  }

  .credits__saga h3 span {
    color: var(--muted);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 500;
  }

  .credits__list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }

  .credits__later {
    margin: 0 0 var(--space-4);
  }

  .credits__later summary {
    min-height: 44px;
    padding-block: var(--space-2);
    color: var(--muted);
    cursor: pointer;
  }

  .credits__list span {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: var(--step-0);
  }
</style>
